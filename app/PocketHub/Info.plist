<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's Info.plist, whole but for the icon. Xcode copies it into the
  bundle and replaces each $(…) with the target's build setting of that name:
  the bundle id and the version are build settings because Xcode signs and
  archives with them. The icon's two keys (CFBundleIconFile, CFBundleIconName)
  are not here: Xcode adds them when it compiles the icon the target names
  (ASSETCATALOG_COMPILER_APPICON_NAME, which is AppIcon.icon).

  Pocket Hub keeps running in the menu bar with its window closed, so macOS
  must not end it as an idle app with no windows (automatic termination) nor
  kill it without asking (sudden termination): quitting goes through the
  app, which decides whether the core stops too.

  CFBundleURLTypes registers the app for pocket-hub: links, which a web page
  opens it with (docs/DEEP-LINKS.md §1).

  The app updates itself with Sparkle (AppUpdater.swift). CFBundleVersion is
  the marketing version, as Sparkle orders releases by it. The feed is the
  appcast.xml of the latest release on GitHub, which app/scripts/package.sh
  writes. Every update is checked against SUPublicEDKey, the public half of
  the release key, before it is opened (SUVerifyUpdateBeforeExtraction), and
  so is the feed itself (SURequireSignedFeed). Were the key lost, an update
  signed with the same Developer ID can bring a new one (Sparkle, "Rotating
  signing keys"); with the update verified before it is opened, only a disk
  image can, which is why the update is the disk image. Checks and installs
  are automatic from the first launch, without Sparkle's question: an update
  downloads in the background and is installed when the app quits.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Pocket Hub</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>Pocket Hub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pocket-hub</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(MARKETING_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/pocket-nexus/pocket-hub/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>XxG0Eqv5FYXkW2jlDbk6i+54y0cg6RlqwEXdkmk6Rmc=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
