    "%@ Is Paired" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Is Paired"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已配对"
          }
        }
      }
    },
    "%@ can't delete applets from this Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't delete applets from this Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法从这台 Mac 删除小程序。"
          }
        }
      }
    },
    "%@ can't do this." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't do this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法执行此操作。"
          }
        }
      }
    },
    "%@ didn't respond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ didn't respond."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。"
          }
        }
      }
    },
    "%@ hasn't connected yet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hasn't connected yet"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还没有连接过"
          }
        }
      }
    },
    "%@ hasn't connected yet, so Pocket Hub can't tell whether it runs this applet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hasn't connected yet, so Pocket Hub can't tell whether it runs this applet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还没有连接过，Pocket Hub 无法判断它能否运行这个小程序。"
          }
        }
      }
    },
    "%@ hasn't reconnected after the update." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hasn't reconnected after the update."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 更新后还没有重新连接。"
          }
        }
      }
    },
    "%@ installs applets itself, from the store on the device. This Mac sends them while Pocket Hub is running." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ installs applets itself, from the store on the device. This Mac sends them while Pocket Hub is running."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要在设备上自己安装小程序：请使用设备上的商店。Pocket Hub 运行时，这台 Mac 会把小程序发送给它。"
          }
        }
      }
    },
    "%@ installs applets itself: open **Mac** on its home screen. This Mac sends them while Pocket Hub is running." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ installs applets itself: open **Mac** on its home screen. This Mac sends them while Pocket Hub is running."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要在设备上自己安装小程序：请在它的主屏幕上打开 **Mac**。Pocket Hub 运行时，这台 Mac 会把小程序发送给它。"
          }
        }
      }
    },
